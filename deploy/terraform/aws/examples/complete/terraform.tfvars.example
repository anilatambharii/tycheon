# Example values only - no secrets belong in this file.
# 123456789012 is the AWS documentation placeholder account; replace it with yours.

region      = "us-east-1"
account_id  = "123456789012"
environment = "prod"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr           = "10.40.0.0/16"

# IAM roles that get cluster-admin through EKS access entries (your platform team / SSO role).
eks_admin_role_arns = ["arn:aws:iam::123456789012:role/platform-admins"]

# Public ALB. Narrow this if the API should only be reachable from known networks.
alb_ingress_cidrs = ["0.0.0.0/0"]

# GPU pool scales from zero; raise max_size to match your quota (Running On-Demand G and VT instances).
gpu_node_group = {
  instance_types = ["g5.2xlarge"]
  min_size       = 0
  desired_size   = 0
  max_size       = 4
}

tags = {
  CostCenter = "tycheon-cloud"
  Owner      = "platform"
}
