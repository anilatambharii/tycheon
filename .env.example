# Tycheon — example environment. Copy to `.env` and fill in locally.
#   cp .env.example .env
# `.env` is gitignored. NEVER put a real secret in this file; it is committed.

# ---------------------------------------------------------------- runtime
TYCHEON_ENV=local               # local | dev | staging | prod
TYCHEON_LOG_LEVEL=INFO

# Hard safety switch. v1 ships no live brokerage execution: paper and
# simulation only, and only through Keelgate-governed tools (from T4).
# Leave this false.
TYCHEON_ALLOW_LIVE_EXECUTION=false

# Point-in-time discipline. Every data read takes an `as_of` and refuses rows
# published after it. This is the default clamp for CLIs and examples that do
# not pass one explicitly; blank means "now", which is only safe for live use.
TYCHEON_DEFAULT_AS_OF=

# ---------------------------------------------------- datastores (make up)
DATABASE_URL=postgresql://tycheon:tycheon@localhost:5432/tycheon
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage for Parquet panels, forecasts and model cards.
# `make up` runs MinIO locally with the placeholder credentials below.
TYCHEON_S3_ENDPOINT_URL=http://localhost:9000
TYCHEON_S3_BUCKET=tycheon-dev
TYCHEON_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=tycheon-local
# Local only: copy MINIO_ROOT_PASSWORD from docker-compose.dev.yml.
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------ market data
# Providers are pluggable and you bring your own data license. Tycheon never
# redistributes licensed exchange data.
TYCHEON_DATA_PROVIDER=sample    # sample | yfinance | <your provider>
# yfinance is for local development and examples only. It is not licensed for
# the cloud product and must never be enabled there.
TYCHEON_ALLOW_YFINANCE=false
TYCHEON_DATA_API_KEY=

# ------------------------------------------------------------ model hosts
# Foundation-model weights are fetched from the Hugging Face Hub by the
# `kronos`, `timesfm` and `chronos` extras.
HF_HOME=
HUGGINGFACE_HUB_TOKEN=
TYCHEON_MODEL_DEVICE=cpu        # cpu | cuda | mps

# ------------------------------------------------------- observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=tycheon
OTEL_TRACES_EXPORTER=otlp

# --------------------------------------------------- governance (from T4)
# Keelgate is the safety harness. Phases T0-T3 do not depend on it; these keys
# are documented here so the T4 surface is no surprise.
# KEELGATE_POLICY_PACK=finance_basic
# KEELGATE_AUDIT_SIGNING_KEY=

# --------------------------------------------------- cloud (ee/) only
STRIPE_API_KEY=
TYCHEON_CLOUD_CONTROL_PLANE_URL=
