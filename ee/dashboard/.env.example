# Base URL of the Tycheon control plane (server-side only; never exposed to the browser).
CONTROL_PLANE_URL=http://localhost:8080

# Public leaderboard embedded on /leaderboard (also added to the CSP frame-src).
NEXT_PUBLIC_LEADERBOARD_URL=https://anilatambharii.github.io/tycheon/leaderboard/

# Browser-reachable base URL of the control plane, used only to start SSO (/auth/oidc/{slug}/login).
# May differ from CONTROL_PLANE_URL when the BFF reaches the control plane over an internal address.
CONTROL_PLANE_PUBLIC_URL=http://localhost:8080
