# Normalize to LF in the repo so ruff, pre-commit and CI agree across Windows/Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.parquet binary
*.safetensors binary

LICENSE    text eol=lf linguist-vendored
ee/LICENSE text eol=lf

# Vendored upstream: keep byte-identical and out of language stats.
third_party/** linguist-vendored
